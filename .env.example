# Database — H2 file DB by default (no install required)
# To use PostgreSQL: jdbc:postgresql://localhost:5432/repolens
DATASOURCE_URL=jdbc:h2:file:./repolens-dev;AUTO_SERVER=TRUE
DATASOURCE_USERNAME=sa
DATASOURCE_PASSWORD=

# GitHub token (optional — raises API rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=

# OpenAI (optional — without it the app returns stub analysis text)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Redis (optional — caching degrades gracefully if unavailable)
REDIS_HOST=localhost
REDIS_PORT=6379

# Server
SERVER_PORT=8080
