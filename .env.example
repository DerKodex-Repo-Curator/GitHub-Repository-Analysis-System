# PostgreSQL (running locally on default port)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=github_analysis
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/github_analysis

# GitHub token (optional, improves rate limits)
GITHUB_TOKEN=

# FastAPI
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000

# Spring Boot
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/github_analysis
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
FASTAPI_BASE_URL=http://localhost:8000

# Redis (run locally: redis-server)
REDIS_URL=redis://localhost:6379
