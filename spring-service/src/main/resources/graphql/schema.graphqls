type Repository {
    id: ID!
    githubUrl: String!
    name: String
    description: String
    language: String
    stars: Int
    createdAt: String
    lastAnalyzed: String
    analysis: Analysis
}

type Analysis {
    id: ID!
    repositoryId: ID!
    summary: String!
    complexityScore: Float!
    topics: [String!]!
    analyzedAt: String
}

type Query {
    repository(id: ID!): Repository
    repositories(language: String, limit: Int): [Repository!]!
    analysis(repositoryId: ID!): Analysis
}

type Mutation {
    addRepository(githubUrl: String!): Repository!
    analyzeRepository(id: ID!): String!
}
